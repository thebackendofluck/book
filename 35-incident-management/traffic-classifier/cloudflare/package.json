{
  "name": "edge-traffic-classifier",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Workers edge DDoS detection and campaign-aware rate limiting",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src test --ext .ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.124.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "undici": "^8.12.2",
    "devalue": "^5.8.1",
    "ws": "^8.21.3",
    "sharp": "^0.35.5",
    "postcss": "^8.5.23"
  }
}
