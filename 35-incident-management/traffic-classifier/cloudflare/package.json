{
  "name": "edge-traffic-classifier",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Workers edge DDoS detection and campaign-aware rate limiting",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src test --ext .ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20241112.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6",
    "wrangler": ">=4.59.1"
  },
  "overrides": {
    "esbuild": ">=0.28.1",
    "undici": ">=8.9.0",
    "vite": ">=6.4.2",
    "wrangler": ">=4.59.1",
    "devalue": "^5.8.1",
    "ws": "^8.21.0",
    "sharp": "^0.35.0",
    "postcss": "8.5.23"
  }
}
