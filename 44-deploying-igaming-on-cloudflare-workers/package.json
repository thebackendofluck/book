{
  "name": "acmetocasino-cloudflare-worker",
  "version": "1.0.0",
  "description": "AcmeToCasino Platform - Cloudflare Workers backend",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply acmetocasino-prod --local",
    "db:migrate:remote": "wrangler d1 migrations apply acmetocasino-prod"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "casino",
    "gaming",
    "typescript"
  ],
  "license": "Apache-2.0",
  "private": true,
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^8.57.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.124.0"
  }
}
