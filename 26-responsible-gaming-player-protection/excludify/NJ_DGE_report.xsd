<?xml version="1.0" encoding="UTF-8"?>
<!-- NJ DGE Self-Exclusion Report Schema -->
<!-- Defines the XML format for operator self-exclusion reports submitted to the NJ Division of Gaming Enforcement -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
 <xs:element name="DGE_Report">
  <xs:annotation>
   <xs:documentation>Root Element</xs:documentation>
  </xs:annotation>
  <xs:complexType>
   <xs:sequence>
    <xs:element name="Report_Date" type="xs:date">
     <xs:annotation>
      <xs:documentation>Date for which the Report is Generated</xs:documentation>
     </xs:annotation>
    </xs:element>
    <xs:element name="License_ID">
     <xs:annotation>
      <xs:documentation>The Casino Permit Holder Billing number assigned by DGE</xs:documentation>
     </xs:annotation>
     <xs:simpleType>
      <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{1,4}-[0-9]{2}"/>
      </xs:restriction>
     </xs:simpleType>
    </xs:element>
    <xs:element ref="playerData" minOccurs="0" maxOccurs="unbounded"/>
   </xs:sequence>
   <xs:attribute name="type" type="xs:string" use="optional" default="Operator_Exclusion_List">
    <xs:annotation>
     <xs:documentation>Type of Report. Shall default to Operator_Exclusion_List</xs:documentation>
    </xs:annotation>
   </xs:attribute>
  </xs:complexType>
 </xs:element>
 <xs:element name="playerData">
  <xs:annotation>
   <xs:documentation>Parent Element for patron records</xs:documentation>
  </xs:annotation>
  <xs:complexType>
   <xs:sequence>
    <xs:element name="Player_ID" type="xs:token"/>
    <xs:element name="Skin_ID" type="xs:int"/>
    <xs:element name="Name" type="xs:string"/>
    <xs:element name="Middle_Name" type="xs:string" minOccurs="0"/>
    <xs:element name="Surname" type="xs:string"/>
    <xs:element name="Street_Address_1" type="xs:string"/>
    <xs:element name="Street_Address_2" minOccurs="0" type="xs:string"/>
    <xs:element name="City" type="xs:string"/>
    <xs:element name="State" minOccurs="0">
     <xs:simpleType>
      <xs:restriction base="xs:string">
       <xs:maxLength value="2"/>
      </xs:restriction>
     </xs:simpleType>
    </xs:element>
    <xs:element name="Country">
     <xs:annotation>
      <xs:documentation>ISO 3166-1 alpha-2 country code</xs:documentation>
     </xs:annotation>
     <xs:simpleType>
      <xs:restriction base="xs:string">
       <xs:maxLength value="2"/>
      </xs:restriction>
     </xs:simpleType>
    </xs:element>
    <xs:element name="ZIP_Code" type="xs:string"/>
    <xs:element name="Document_Type">
     <xs:simpleType>
      <xs:restriction base="xs:string">
       <xs:enumeration value="SSN"/>
       <xs:enumeration value="Passport"/>
       <xs:enumeration value="Govt_ID"/>
       <xs:enumeration value="Driver License"/>
       <xs:enumeration value="Other"/>
      </xs:restriction>
     </xs:simpleType>
    </xs:element>
    <xs:element name="Country_ID" minOccurs="0">
     <xs:simpleType>
      <xs:restriction base="xs:string">
       <xs:pattern value="[A-Z][A-Z]"/>
      </xs:restriction>
     </xs:simpleType>
    </xs:element>
    <xs:element name="SSN" minOccurs="0">
     <xs:annotation>
      <xs:documentation>Social Security Number, full or last 4 digits</xs:documentation>
     </xs:annotation>
     <xs:simpleType>
      <xs:restriction base="xs:string">
       <xs:maxLength value="9"/>
      </xs:restriction>
     </xs:simpleType>
    </xs:element>
    <xs:element name="Personal_ID" type="xs:string"/>
    <xs:element name="DOB" type="xs:date"/>
    <xs:element name="Submit_Date" type="xs:dateTime"/>
    <xs:element name="Duration">
     <xs:simpleType>
      <xs:restriction base="xs:string">
       <xs:enumeration value="1 YEAR"/>
       <xs:enumeration value="5 YEAR"/>
      </xs:restriction>
     </xs:simpleType>
    </xs:element>
    <xs:element name="LastLogin" type="xs:dateTime"/>
    <xs:element name="Remote_IP">
     <xs:simpleType>
      <xs:restriction base="xs:token">
       <xs:pattern value="([0-9]{1,3}[.]){3}[0-9]{1,3}"/>
      </xs:restriction>
     </xs:simpleType>
    </xs:element>
   </xs:sequence>
  </xs:complexType>
 </xs:element>
</xs:schema>
