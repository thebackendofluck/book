# Dockerfile.debug — stored in internal registry as casino/debug-tools:latest
# Built and pushed via CI, never modified ad-hoc
# NOTE: Debug image — not for production. Runs as debugger (non-root) user.
# Interactive use requires: docker run --rm -it --user debugger <image> bash

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Network tools
    curl \
    wget \
    netcat-openbsd \
    tcpdump \
    nmap \
    dnsutils \
    iproute2 \
    iptables \
    iputils-ping \
    # TLS tools
    openssl \
    ca-certificates \
    # Python for scripting
    python3 \
    python3-pip \
    python3-requests \
    # Process inspection
    procps \
    strace \
    lsof \
    # Database clients
    postgresql-client \
    redis-tools \
    && rm -rf /var/lib/apt/lists/*

# Install Python debugger and HTTP testing tools
RUN pip3 install --no-cache-dir \
    httpx \
    rich \
    pdbpp

# Create non-root debugger user (debug tools still available but not running as root)
RUN groupadd -r debugger && useradd -r -g debugger -m -s /bin/bash debugger

USER debugger

HEALTHCHECK --interval=60s --timeout=5s --retries=2 \
    CMD id || exit 1

CMD ["bash"]
