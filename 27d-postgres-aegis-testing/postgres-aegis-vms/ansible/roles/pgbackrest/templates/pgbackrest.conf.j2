[global]
repo1-type                  = {{ pgbackrest_repo_type }}
repo1-s3-endpoint           = {{ pgbackrest_s3_endpoint | default('https://s3.eu-central-1.wasabisys.com') }}
repo1-s3-bucket             = {{ pgbackrest_s3_bucket | default('ops-host-backup') }}
repo1-s3-region             = eu-central-1
repo1-s3-key                = {{ pgbackrest_s3_key }}
repo1-s3-key-secret         = {{ pgbackrest_s3_secret }}
repo1-path                  = /{{ pgbackrest_s3_path | default('postgres-aegis-smoke') }}/{{ pgbackrest_stanza }}
repo1-cipher-type           = {{ pgbackrest_cipher_type }}
repo1-cipher-pass           = {{ pgbackrest_cipher_pass }}
repo1-retention-full        = {{ pgbackrest_retention_full }}
repo1-retention-diff        = {{ pgbackrest_retention_diff }}
compress-type               = {{ pgbackrest_compress_type }}
process-max                 = 4
log-level-console           = info
log-level-file              = detail
log-path                    = /var/log/pgbackrest
start-fast                  = y
delta                       = y

[{{ pgbackrest_stanza }}]
pg1-path = {{ pgdata_mount }}/pgdata
pg1-port = {{ pg_port }}
pg1-user = postgres
