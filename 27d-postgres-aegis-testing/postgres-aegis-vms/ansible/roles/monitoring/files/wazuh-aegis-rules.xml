<!--
  Wazuh custom rules for postgres-aegis cluster.
  Deploy to: /var/ossec/etc/rules/postgres-aegis-rules.xml on the Wazuh manager.

  Rule ID range: 100800–100849 (local namespace, below chapter-24 Wazuh rules).

  Log sources monitored:
    - /var/log/postgresql/postgresql-16-main.log  (PG / Patroni)
    - /var/log/pgbackrest/                        (pgbackrest)
    - /opt/aegis-monitoring/mtls-status.json      (mTLS rotation)
    - /var/log/syslog                             (systemd timer events)
    - journald                                    (Patroni failover)
-->

<group name="postgres-aegis,postgresql,patroni,">

  <!-- ============================================================
       PATRONI EVENTS
       ============================================================ -->

  <rule id="100800" level="12">
    <decoded_as>json</decoded_as>
    <field name="message" type="pcre2">promoted to leader|became the leader|I am the leader</field>
    <description>Patroni: node promoted to leader ($(hostname))</description>
    <group>postgres-aegis,patroni,failover,gdpr_audit,</group>
    <options>alert_by_email</options>
  </rule>

  <rule id="100801" level="10">
    <decoded_as>json</decoded_as>
    <field name="message" type="pcre2">demoted self|not a leader anymore|stepped down</field>
    <description>Patroni: leader stepped down / demoted</description>
    <group>postgres-aegis,patroni,failover,</group>
  </rule>

  <rule id="100802" level="13">
    <decoded_as>json</decoded_as>
    <field name="message" type="pcre2">failover.*completed|switchover.*completed</field>
    <description>Patroni: failover/switchover completed</description>
    <group>postgres-aegis,patroni,failover,gdpr_audit,</group>
    <options>alert_by_email</options>
  </rule>

  <rule id="100803" level="14">
    <decoded_as>json</decoded_as>
    <field name="message" type="pcre2">no leader.*found|DCS.*unreachable|etcd.*timed out</field>
    <description>Patroni: DCS unreachable or no leader — cluster at risk</description>
    <group>postgres-aegis,patroni,etcd,high_importance,</group>
    <options>alert_by_email</options>
  </rule>

  <!-- ============================================================
       PG AUTHENTICATION / AUDIT
       ============================================================ -->

  <rule id="100810" level="8">
    <decoded_as>json</decoded_as>
    <field name="message" type="pcre2">AUDIT:.*DDL|AUDIT:.*FUNCTION|AUDIT:.*ROLE</field>
    <description>pgaudit: DDL/Function/Role change detected</description>
    <group>postgres-aegis,pgaudit,gdpr_audit,</group>
  </rule>

  <rule id="100811" level="10">
    <decoded_as>json</decoded_as>
    <field name="message" type="pcre2">connection authorized.*ssl=on.*tls1\.3</field>
    <description>PG: client connected with mTLS TLS 1.3 (expected path)</description>
    <group>postgres-aegis,mtls,</group>
    <options>no_alert</options>
  </rule>

  <rule id="100812" level="12">
    <decoded_as>json</decoded_as>
    <field name="message" type="pcre2">connection.*ssl=off|no encryption</field>
    <description>PG: connection established WITHOUT TLS — policy violation</description>
    <group>postgres-aegis,mtls,policy_violation,gdpr_audit,</group>
    <options>alert_by_email</options>
  </rule>

  <rule id="100813" level="11">
    <decoded_as>json</decoded_as>
    <field name="message" type="pcre2">certificate authentication failed|peer authentication failed</field>
    <description>PG: client certificate authentication failure</description>
    <group>postgres-aegis,mtls,authentication,</group>
  </rule>

  <rule id="100814" level="14" frequency="5" timeframe="60">
    <if_matched_sid>100813</if_matched_sid>
    <description>PG: 5+ cert auth failures in 60s — possible credential brute-force</description>
    <group>postgres-aegis,mtls,authentication,attack,</group>
    <options>alert_by_email</options>
  </rule>

  <!-- ============================================================
       MTLS ROTATION EVENTS (from aegis-mtls-status.timer output)
       ============================================================ -->

  <rule id="100820" level="5">
    <decoded_as>json</decoded_as>
    <field name="program_name">aegis-mtls-rotate</field>
    <field name="message" type="pcre2">rotation complete|certificates renewed</field>
    <description>postgres-aegis: mTLS certificate rotation completed successfully</description>
    <group>postgres-aegis,mtls,rotation,gdpr_audit,</group>
  </rule>

  <rule id="100821" level="12">
    <decoded_as>json</decoded_as>
    <field name="program_name">aegis-mtls-rotate</field>
    <field name="message" type="pcre2">rotation.*failed|ERROR.*cert|FAILED.*rotate</field>
    <description>postgres-aegis: mTLS rotation FAILED</description>
    <group>postgres-aegis,mtls,rotation,high_importance,</group>
    <options>alert_by_email</options>
  </rule>

  <!-- ============================================================
       PGBACKREST EVENTS
       ============================================================ -->

  <rule id="100830" level="5">
    <decoded_as>json</decoded_as>
    <field name="message" type="pcre2">backup command begin.*type=full</field>
    <description>pgbackrest: full backup started</description>
    <group>postgres-aegis,pgbackrest,backup,</group>
  </rule>

  <rule id="100831" level="5">
    <decoded_as>json</decoded_as>
    <field name="message" type="pcre2">backup command end.*completed successfully</field>
    <description>pgbackrest: backup completed successfully</description>
    <group>postgres-aegis,pgbackrest,backup,gdpr_audit,</group>
  </rule>

  <rule id="100832" level="13">
    <decoded_as>json</decoded_as>
    <field name="message" type="pcre2">backup command end.*ERROR|backup.*failed|WARN.*backup</field>
    <description>pgbackrest: backup FAILED or completed with warnings</description>
    <group>postgres-aegis,pgbackrest,backup,high_importance,</group>
    <options>alert_by_email</options>
  </rule>

  <rule id="100833" level="8">
    <decoded_as>json</decoded_as>
    <field name="message" type="pcre2">restore command begin</field>
    <description>pgbackrest: restore operation started</description>
    <group>postgres-aegis,pgbackrest,restore,gdpr_audit,</group>
    <options>alert_by_email</options>
  </rule>

  <!-- ============================================================
       AUTOSCALER EVENTS
       ============================================================ -->

  <rule id="100840" level="5">
    <decoded_as>json</decoded_as>
    <field name="program_name">aegis-autoscaler</field>
    <field name="message" type="pcre2">decisions: 0</field>
    <description>postgres-aegis autoscaler: no scaling action needed</description>
    <group>postgres-aegis,autoscaler,</group>
    <options>no_alert</options>
  </rule>

  <rule id="100841" level="7">
    <decoded_as>json</decoded_as>
    <field name="program_name">aegis-autoscaler</field>
    <field name="message" type="pcre2">scale_up_reader|scale_up_node</field>
    <description>postgres-aegis autoscaler: scale-UP decision emitted</description>
    <group>postgres-aegis,autoscaler,capacity,</group>
  </rule>

  <rule id="100842" level="6">
    <decoded_as>json</decoded_as>
    <field name="program_name">aegis-autoscaler</field>
    <field name="message" type="pcre2">scale_down_reader</field>
    <description>postgres-aegis autoscaler: scale-DOWN decision emitted</description>
    <group>postgres-aegis,autoscaler,capacity,</group>
  </rule>

  <!-- ============================================================
       LUKS / DISK ENCRYPTION
       ============================================================ -->

  <rule id="100845" level="14">
    <decoded_as>json</decoded_as>
    <field name="message" type="pcre2">LUKS.*failed|cryptsetup.*error|mapper.*pgdata_crypt.*failed</field>
    <description>postgres-aegis: LUKS encrypted disk mount FAILED — data directory inaccessible</description>
    <group>postgres-aegis,luks,storage,high_importance,</group>
    <options>alert_by_email</options>
  </rule>

  <rule id="100846" level="5">
    <decoded_as>json</decoded_as>
    <field name="message" type="pcre2">pgdata_crypt.*active|LUKS.*unlocked successfully</field>
    <description>postgres-aegis: LUKS volume unlocked (expected at boot)</description>
    <group>postgres-aegis,luks,storage,</group>
    <options>no_alert</options>
  </rule>

</group>
