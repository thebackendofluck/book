# Rendered by Ansible. Exporter reads pg_stat_activity, pg_stat_replication,
# pg_stat_statements, pg_stat_wal_receiver. Uses a read-only role.
DATA_SOURCE_NAME="postgresql://postgres_exporter@127.0.0.1:{{ pg_port }}/{{ pg_database }}?sslmode=verify-full&passfile=/etc/postgres-exporter.pgpass"
PG_EXPORTER_EXCLUDE_DATABASES="template0,template1"
PG_EXPORTER_AUTO_DISCOVER_DATABASES="true"
PG_EXPORTER_DISABLE_DEFAULT_METRICS="false"
