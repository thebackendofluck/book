[Unit]
Description=Unlock PostgreSQL Aegis data disk via YubiHSM-wrapped OpenBao passphrase
DefaultDependencies=no
After=network-online.target bao-agent.service
Wants=network-online.target
Before=postgresql.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pg-aegis-luks-unlock.sh
RemainAfterExit=true
TimeoutStartSec=60s

[Install]
WantedBy=multi-user.target
