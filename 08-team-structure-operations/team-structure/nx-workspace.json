{
  "version": 2,
  "projects": {
    "fe-main-app": {
      "projectType": "application",
      "root": "apps/fe-main-app",
      "sourceRoot": "apps/fe-main-app/src",
      "targets": {
        "build": {
          "executor": "@nx-plus/vue:browser",
          "options": {
            "dest": "dist/apps/fe-main-app",
            "index": "apps/fe-main-app/public/index.html",
            "main": "apps/fe-main-app/src/main.ts",
            "tsConfig": "apps/fe-main-app/tsconfig.app.json"
          },
          "configurations": {
            "production": {
              "mode": "production",
              "filenameHashing": true,
              "productionSourceMap": true
            }
          }
        },
        "serve": {
          "executor": "@nx-plus/vue:dev-server",
          "options": {
            "browserTarget": "fe-main-app:build",
            "port": 8000
          }
        },
        "lint": {
          "executor": "@nrwl/linter:eslint",
          "options": {
            "lintFilePatterns": ["apps/fe-main-app/**/*.{ts,tsx,vue}"]
          }
        },
        "test": {
          "executor": "@nrwl/jest:jest",
          "outputs": ["coverage/apps/fe-main-app"],
          "options": {
            "jestConfig": "apps/fe-main-app/jest.config.js",
            "passWithNoTests": true
          }
        }
      },
      "tags": []
    },
    "player-service": "apps/player-service",
    "search-service": "apps/search-service",
    "utils-service": "apps/utils-service",
    "feature-dashboard": {
      "projectType": "library",
      "root": "libs/feature-dashboard",
      "sourceRoot": "libs/feature-dashboard/src",
      "targets": {
        "lint": {
          "executor": "@nrwl/linter:eslint",
          "options": {
            "lintFilePatterns": ["libs/feature-dashboard/**/*.{ts,tsx,vue}"]
          }
        },
        "test": {
          "executor": "@nrwl/jest:jest",
          "outputs": ["coverage/libs/feature-dashboard"],
          "options": {
            "jestConfig": "libs/feature-dashboard/jest.config.js",
            "passWithNoTests": true
          }
        }
      },
      "tags": []
    },
    "feature-players": {
      "projectType": "library",
