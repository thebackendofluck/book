# KYC Anti-Fraud System Environment Variables
# Copy this file to .env and configure with your values

# Database Configuration
DB_HOST=postgres-db
DB_USER=kyc_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_NAME=kyc_db

# Redis Configuration
REDIS_HOST=redis-cache
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# MongoDB Configuration
MONGO_USER=mongo_admin
MONGO_PASSWORD=CHANGE_THIS_MONGO_PASSWORD

# Elasticsearch Configuration  
ELASTIC_PASSWORD=CHANGE_THIS_ELASTIC_PASSWORD
KIBANA_PASSWORD=CHANGE_THIS_KIBANA_PASSWORD

# Encryption and Security
MASTER_ENCRYPTION_KEY=CHANGE_THIS_256_BIT_KEY_BASE64_ENCODED
HSM_ENDPOINT=hsm.provider.com:443
HSM_SLOT=0
HSM_LIB_PATH=/usr/lib/softhsm/libsofthsm2.so
JWT_SECRET=CHANGE_THIS_JWT_SECRET

# Service Configuration
MAX_PROCESSING_TIME=30s
AUTO_DESTRUCT=true
DATA_RETENTION_DAYS=90
DELETION_METHOD=DOD_5220_22_M
OVERWRITE_PASSES=7
VERIFICATION_REQUIRED=true
GDPR_COMPLIANCE=true
SCHEDULED_CLEANUP_HOUR=3

# ML and Biometric Configuration
FACE_MATCH_THRESHOLD=0.95
LIVENESS_DETECTION=enabled
MAX_RETRY_ATTEMPTS=3
SPOOFING_DETECTION=true
USE_GPU=false
MODEL_UPDATE_FREQUENCY=daily
MIN_CONFIDENCE_SCORE=0.7

# Compliance Configuration
GDPR_MODE=strict
AUDIT_LOG_LEVEL=verbose
SANCTIONS_LIST_UPDATE=daily
AML_THRESHOLD=10000
JURISDICTION=EU

# External API Keys
OFAC_API_KEY=YOUR_OFAC_API_KEY
WORLDCHECK_API_KEY=YOUR_WORLDCHECK_API_KEY
PEP_DATABASE_URL=https://pep-api.provider.com
JUMIO_API_KEY=YOUR_JUMIO_API_KEY
ONFIDO_API_KEY=YOUR_ONFIDO_API_KEY
SUMSUB_API_KEY=YOUR_SUMSUB_API_KEY

# AWS Configuration (for backups)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
BACKUP_S3_BUCKET=kyc-backups
BACKUP_ENCRYPTION_KEY=CHANGE_THIS_BACKUP_KEY

# Monitoring Configuration
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD

# Casino/Operator Information
CASINO_NAME=Your Casino Name
OPERATOR_LICENSE=LICENSE_NUMBER
REGULATORY_BODY=MGA

# Network Configuration
CORS_ORIGINS=https://casino.example.com,https://admin.casino.example.com
RATE_LIMIT=100/minute

# Feature Flags
ENABLE_BIOMETRIC_VERIFICATION=true
ENABLE_DOCUMENT_OCR=true
ENABLE_SANCTIONS_SCREENING=true
ENABLE_PEP_CHECK=true
ENABLE_AML_MONITORING=true
ENABLE_FRAUD_DETECTION=true
ENABLE_GDPR_AUTOMATION=true

# Performance Tuning
WORKER_PROCESSES=4
THREAD_POOL_SIZE=10
CONNECTION_POOL_SIZE=20
CACHE_TTL=3600

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
