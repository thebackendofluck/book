# Copy this to config.env and edit. Then run ./deploy.sh.
# All values have safe defaults that match the book chapter.

# The data-root directory used by Docker (after the migration in Section 33e)
# Default: /var/lib/docker (no migration). Set to your ZFS pool path if you've moved it.
DOCKER_DATA_ROOT=/var/lib/docker

# Container log size threshold above which the daily prune script will truncate
# (in bytes; default 5 GB). Set higher if you have legitimately verbose containers.
CONTAINER_LOG_TRUNCATE_THRESHOLD=5368709120

# Filesystems to monitor in Prometheus rules (regex of mountpoints)
# Default covers / and a custom data pool. Adjust for your environment.
FILESYSTEM_MOUNTPOINTS="/|/data-pool"

# Wazuh manager credentials (only needed if you also apply the ISM policy)
# Leave empty if Wazuh isn't deployed; the alert rule still works.
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=

# Where to install the maintenance scripts (must be in PATH for systemd)
INSTALL_BIN_DIR=/usr/local/sbin

# Hostname label that appears in alerts (descriptive only)
ALERT_HOSTNAME_LABEL=ops-host
