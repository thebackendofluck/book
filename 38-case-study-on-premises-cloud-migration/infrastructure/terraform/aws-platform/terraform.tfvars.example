# =============================================================================
# Example terraform.tfvars — Casino Platform
# =============================================================================
# Copy this file to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars to version control (it may contain secrets).
# =============================================================================

# --- General -----------------------------------------------------------------
project_name = "acmetocasino"
environment  = "prod"
aws_region   = "us-east-1"

# --- Networking --------------------------------------------------------------
vpc_cidr           = "10.20.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]

# --- ECS / Fargate -----------------------------------------------------------
api_cpu           = 512
api_memory        = 1024
api_desired_count = 2
api_min_count     = 2
api_max_count     = 10

# --- RDS PostgreSQL ----------------------------------------------------------
db_instance_class        = "db.t4g.medium"
db_allocated_storage     = 50
db_max_allocated_storage = 500
db_name                  = "casino_platform"
db_username              = "casino_admin"

# --- ElastiCache Redis -------------------------------------------------------
redis_node_type          = "cache.t4g.medium"
redis_num_cache_clusters = 2

# --- ALB / HTTPS -------------------------------------------------------------
domain_name     = "api.acmetocasino.com"
certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# --- CI/CD -------------------------------------------------------------------
github_repo             = "acmetocasino/casino-platform"
github_branch           = "main"
codestar_connection_arn = "arn:aws:codestar-connections:us-east-1:123456789012:connection/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# --- Monitoring --------------------------------------------------------------
alarm_sns_email          = "ops@acmetocasino.com"
api_latency_threshold_ms = 500
api_error_rate_threshold = 1
db_connections_threshold = 80
