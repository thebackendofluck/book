{
  "name": "igaming-datalake-etl-workflow",
  "description": "Daily ETL workflow for iGaming data lake: Bronze -> Silver -> Gold",
  "email_notifications": {
    "on_failure": ["data-platform@company.com"],
    "on_success": [],
    "no_alert_for_skipped_runs": true
  },
  "webhook_notifications": {},
  "timeout_seconds": 7200,
  "max_concurrent_runs": 1,
  "schedule": {
    "quartz_cron_expression": "0 0 5 * * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "tags": {
    "team": "data-platform",
    "environment": "production",
    "cost_center": "analytics"
  },
  "tasks": [
    {
      "task_key": "bronze_to_silver",
      "description": "Transform raw data from Bronze to cleaned Silver layer",
      "notebook_task": {
        "notebook_path": "/Repos/data-platform/igaming-datalake/notebooks/bronze_to_silver_delta",
        "base_parameters": {
          "source_bucket": "s3://igaming-datalake-prod-bronze",
          "target_bucket": "s3://igaming-datalake-prod-silver",
          "catalog": "igaming_catalog",
          "database": "silver",
          "run_mode": "incremental"
        },
        "source": "WORKSPACE"
      },
      "job_cluster_key": "etl_cluster",
      "timeout_seconds": 3600,
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true
    },
    {
      "task_key": "silver_to_gold",
      "description": "Create Gold layer aggregations and analytics tables",
      "depends_on": [
        {
          "task_key": "bronze_to_silver"
        }
      ],
      "notebook_task": {
        "notebook_path": "/Repos/data-platform/igaming-datalake/notebooks/silver_to_gold_delta",
        "base_parameters": {
          "source_catalog": "igaming_catalog",
          "source_database": "silver",
          "target_database": "gold",
          "target_bucket": "s3://igaming-datalake-prod-gold",
          "lookback_days": "1"
        },
        "source": "WORKSPACE"
      },
      "job_cluster_key": "etl_cluster",
      "timeout_seconds": 3600,
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true
    },
    {
      "task_key": "optimize_tables",
      "description": "Run OPTIMIZE and VACUUM on Delta tables",
      "depends_on": [
        {
          "task_key": "silver_to_gold"
        }
      ],
      "notebook_task": {
        "notebook_path": "/Repos/data-platform/igaming-datalake/notebooks/optimize_delta_tables",
        "base_parameters": {
          "catalog": "igaming_catalog",
          "databases": "silver,gold"
        },
        "source": "WORKSPACE"
      },
      "job_cluster_key": "maintenance_cluster",
      "timeout_seconds": 1800,
      "max_retries": 1
    },
    {
      "task_key": "data_quality_checks",
      "description": "Run data quality validation and alerting",
      "depends_on": [
        {
          "task_key": "silver_to_gold"
        }
      ],
      "notebook_task": {
        "notebook_path": "/Repos/data-platform/igaming-datalake/notebooks/data_quality_checks",
        "base_parameters": {
          "catalog": "igaming_catalog",
          "alert_threshold": "0.95"
        },
        "source": "WORKSPACE"
      },
      "job_cluster_key": "maintenance_cluster",
      "timeout_seconds": 1200,
      "max_retries": 1
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "etl_cluster",
      "new_cluster": {
        "cluster_name": "igaming-etl-cluster",
        "spark_version": "14.3.x-scala2.12",
        "spark_conf": {
          "spark.databricks.delta.optimizeWrite.enabled": "true",
          "spark.databricks.delta.autoCompact.enabled": "true",
          "spark.databricks.adaptive.autoOptimizeShuffle.enabled": "true",
          "spark.sql.shuffle.partitions": "auto"
        },
        "aws_attributes": {
          "first_on_demand": 1,
          "availability": "SPOT_WITH_FALLBACK",
          "zone_id": "auto",
          "spot_bid_price_percent": 100
        },
        "node_type_id": "m5.2xlarge",
        "driver_node_type_id": "m5.xlarge",
        "num_workers": 4,
        "autoscale": {
          "min_workers": 2,
          "max_workers": 10
        },
        "enable_elastic_disk": true,
        "data_security_mode": "SINGLE_USER",
        "runtime_engine": "PHOTON",
        "custom_tags": {
          "Team": "data-platform",
          "CostCenter": "analytics",
          "Workload": "etl"
        }
      }
    },
    {
      "job_cluster_key": "maintenance_cluster",
      "new_cluster": {
        "cluster_name": "igaming-maintenance-cluster",
        "spark_version": "14.3.x-scala2.12",
        "aws_attributes": {
          "first_on_demand": 1,
          "availability": "SPOT",
          "zone_id": "auto"
        },
        "node_type_id": "m5.large",
        "driver_node_type_id": "m5.large",
        "num_workers": 2,
        "enable_elastic_disk": true,
        "data_security_mode": "SINGLE_USER",
        "custom_tags": {
          "Team": "data-platform",
          "Workload": "maintenance"
        }
      }
    }
  ],
  "format": "MULTI_TASK",
  "queue": {
    "enabled": true
  },
  "run_as": {
    "user_name": "service-account@company.com"
  }
}
