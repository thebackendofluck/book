[Unit]
Description=Run Wasabi encrypted backup nightly at 03:00
Requires=wasabi-backup.service

[Timer]
# Run at 03:00 every day
OnCalendar=*-*-* 03:00:00
# If the system was off at the scheduled time, run immediately on next boot
Persistent=true
# Add a random delay up to 5 minutes to avoid thundering herd on shared infrastructure
RandomizedDelaySec=300
Unit=wasabi-backup.service

[Install]
WantedBy=timers.target
