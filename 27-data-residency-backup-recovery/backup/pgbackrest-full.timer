[Unit]
Description=pgBackRest Weekly Full Backup Timer
Documentation=https://pgbackrest.org/

[Timer]
# Run on Sunday at 03:00 UTC
OnCalendar=Sun 03:00:00
# Random 10-minute delay to avoid thundering herd on multi-server setups
RandomizedDelaySec=600
# Run missed backups on next startup (e.g., if server was down)
Persistent=true

[Install]
WantedBy=timers.target
