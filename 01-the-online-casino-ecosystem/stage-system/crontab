SHELL=/bin/bash
PATH=/sbin:/bin:/usr/sbin:/usr/bin
MAILTO=root
HOME=/

# Legacy gaming platform scheduled tasks
# AcmetoCasino staging environment
# Shows the operational overhead of a monolithic platform

# Clear PHP Sessions - every minute
* * * * * root cd /var/lib/php/session; find -cmin +24 | xargs rm > /dev/null 2>&1

# Rotate Bingo Logs - daily at 23:59
59 23 * * * root /root/scripts/bingo_rotateLogs.sh

# Coupon Generator - daily at midnight
# Runs under a dedicated, least-privilege service account (not root).
01 00 * * * promo cd /srv/acmetocasino/cron_scripts; php coupon_generator.php >> /var/log/acmetocasino/coupon_generator.log

# Update IDS rules (Suricata/Oinkmaster) - daily at 02:30
30 2 * * * root /etc/oinkmaster/oinkmaster.pl -C /etc/oinkmaster/oinkmaster.conf -o /etc/suricata/rules 2>&1 | logger -t oinkmaster

# MySQL Backup - daily at 07:00
00 7 * * * root /usr/local/bin/automysqlbackup /etc/automysqlbackup/myserver.conf

# Backup logs to S3 - daily at 07:30
30 7 * * * root /root/scripts/s3_sync_backups.sh

# MaxMind GeoIP database update - every Wednesday at noon
0 12 * * 3 root /usr/local/bin/geoipupdate -d /var/www/html/cms/shared/includes/lib/geoip-api/
