{
  "name": "betbr-sports-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker that fetches live sports data from API-Football and serves it via KV cache to the bet-brazil frontend.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "type-check": "tsc --noEmit",
    "kv:create": "wrangler kv namespace create SPORTS_DATA",
    "kv:create:preview": "wrangler kv namespace create SPORTS_DATA --preview",
    "kv:seed": "node scripts/seed-fallback.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.5.4",
    "wrangler": ">=4.59.1"
  },
  "overrides": {
    "esbuild": ">=0.28.1",
    "undici": ">=8.5.0",
    "wrangler": ">=4.59.1",
    "ws": "^8.21.0",
    "sharp": "^0.35.0"
  }
}
