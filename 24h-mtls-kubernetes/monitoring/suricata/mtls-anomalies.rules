# suricata/rules/mtls-anomalies.rules
# Alert on connections to wallet-service from unexpected certificate CNs
alert tls any any -> 10.0.10.0/24 8443 (
  msg:"mTLS: unexpected client cert CN connecting to wallet-service";
  tls.cert_subject; content:"CN="; pcre:"/CN=(?!wallet-service|player-service|game-engine)[^,]+/";
  flow:established,to_server;
  sid:9001001; rev:1;
)

# Alert on legacy TLS 1.2 on the mesh port (mesh policy mandates TLS 1.3, so a
# 1.2 handshake means a non-mesh client or a misconfigured sidecar; this rule
# matches the protocol version only, not the cipher suite or certificate type)
alert tls any any -> 10.0.10.0/24 8443 (
  msg:"mTLS: legacy TLS 1.2 negotiated on internal service port";
  tls.version:"TLS 1.2";
  sid:9001002; rev:1;
)
