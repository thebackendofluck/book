# =============================================================================
# Production Environment Configuration - iGaming Platform
# =============================================================================
# Environment variables for the production deployment. All secrets should be
# injected via GitLab CI/CD variables or HashiCorp Vault -- never stored here.
#
# Usage:
#   source environments/production.env
#   # or in Docker Compose: env_file: environments/production.env
#   # or in Ansible: --extra-vars "@environments/production.env"
#
# IMPORTANT: This file contains NON-SECRET configuration only.
# Secrets (API keys, passwords, tokens) must come from:
#   - GitLab CI/CD protected variables
#   - HashiCorp Vault
#   - Kubernetes secrets
# =============================================================================

# -- Environment identifier --
ENVIRONMENT=production
ENVIRONMENT_TIER=production
DEPLOY_NAMESPACE=igaming-production

# -- Service URLs --
PAM_URL=https://pam.igaming.internal
WALLET_URL=https://wallet.igaming.internal
GAL_URL=https://gal.igaming.internal
COMPLIANCE_URL=https://compliance.igaming.internal
RESPONSIBLE_GAMING_URL=https://rg.igaming.internal
GAME_CONTROL_URL=https://gc.igaming.internal
PLATFORM_URL=https://platform.igaming.internal

# -- Database (credentials via Vault) --
DATABASE_HOST=db-primary.igaming.internal
DATABASE_PORT=5432
DATABASE_NAME=igaming_production
DATABASE_USER=igaming_prod
DATABASE_SSL_MODE=verify-full
DATABASE_POOL_SIZE=50
DATABASE_MAX_OVERFLOW=25
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_REPLICA_HOST=db-replica.igaming.internal
DATABASE_REPLICA_PORT=5432

# -- Redis (HA sentinel) --
REDIS_SENTINEL_HOSTS=redis-sentinel-1.igaming.internal:26379,redis-sentinel-2.igaming.internal:26379,redis-sentinel-3.igaming.internal:26379
REDIS_SENTINEL_MASTER=igaming-master
REDIS_DB=0
REDIS_SSL=true

# -- Message queue (clustered) --
RABBITMQ_HOST=mq-1.igaming.internal,mq-2.igaming.internal,mq-3.igaming.internal
RABBITMQ_PORT=5671
RABBITMQ_VHOST=igaming-production
RABBITMQ_USER=igaming_prod
RABBITMQ_SSL=true

# -- Payment gateways (live mode) --
PAYMENT_MODE=live
STRIPE_API_URL=https://api.stripe.com
STRIPE_MODE=live
ADYEN_API_URL=https://checkout-live.adyen.com
ADYEN_ENVIRONMENT=live
NUVEI_API_URL=https://secure.safecharge.com
PAYSAFE_API_URL=https://api.paysafe.com

# -- Feature flags --
FEATURE_NEW_REGISTRATION_FLOW=true
FEATURE_CRYPTO_DEPOSITS=false
FEATURE_LIVE_DEALER=false
FEATURE_SPORTS_BETTING=false
FEATURE_VIP_PROGRAM=true
FEATURE_ENHANCED_KYC=true

# -- Monitoring --
PROMETHEUS_URL=https://prometheus.igaming.internal
GRAFANA_URL=https://grafana.igaming.internal
LOKI_URL=https://loki.igaming.internal
JAEGER_URL=https://jaeger.igaming.internal
SENTRY_DSN=https://prod-key@sentry.igaming.internal/1
LOG_LEVEL=WARNING
ENABLE_REQUEST_TRACING=true
METRICS_RETENTION_DAYS=365

# -- Compliance --
JURISDICTION=mga
GLI_STANDARD=GLI-11
RNG_VALIDATION_ENABLED=true
RTP_MONITORING_ENABLED=true
RTP_ALERT_THRESHOLD=1.0
AUDIT_LOG_RETENTION_DAYS=2555
RESPONSIBLE_GAMING_ENABLED=true
SELF_EXCLUSION_ENABLED=true
DEPOSIT_LIMIT_DEFAULT=500
SESSION_TIME_LIMIT_MINUTES=480
REALITY_CHECK_INTERVAL_MINUTES=60
GEO_BLOCKING_ENABLED=true
AML_MONITORING_ENABLED=true
KYC_VERIFICATION_REQUIRED=true
PEP_SCREENING_ENABLED=true

# -- Session / Auth --
SESSION_TTL_SECONDS=1800
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7
MAX_CONCURRENT_SESSIONS=2
BRUTE_FORCE_LOCKOUT_ATTEMPTS=5
BRUTE_FORCE_LOCKOUT_MINUTES=30
MFA_REQUIRED_FOR_ADMIN=true
MFA_REQUIRED_FOR_WITHDRAWAL=true

# -- Rate limiting (stricter in production) --
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_API=500/minute
RATE_LIMIT_DEPOSIT=5/minute
RATE_LIMIT_WITHDRAWAL=3/minute

# -- CORS --
CORS_ORIGINS=https://platform.igaming.internal,https://admin.igaming.internal

# -- Encryption --
ENCRYPTION_ALGORITHM=AES-256-GCM
TLS_MIN_VERSION=1.2
HSTS_MAX_AGE=63072000

# -- Backup --
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 */1 * * *
BACKUP_RETENTION_DAYS=90
BACKUP_OFFSITE_ENABLED=true

# -- Deployment --
CANARY_WEIGHT=10
CANARY_OBSERVATION_MINUTES=5
HEALTH_CHECK_INTERVAL_SECONDS=10
HEALTH_CHECK_TIMEOUT_SECONDS=5
ROLLING_UPDATE_MAX_SURGE=1
ROLLING_UPDATE_MAX_UNAVAILABLE=0
