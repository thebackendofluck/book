# =============================================================================
# Staging Environment Configuration - iGaming Platform
# =============================================================================
# Environment variables for the staging deployment. Staging mirrors production
# topology but uses sandbox/test credentials for payment gateways.
#
# Usage:
#   source environments/staging.env
#   # or in Docker Compose: env_file: environments/staging.env
#   # or in Ansible: --extra-vars "@environments/staging.env"
# =============================================================================

# -- Environment identifier --
ENVIRONMENT=staging
ENVIRONMENT_TIER=non-production
DEPLOY_NAMESPACE=igaming-staging

# -- Service URLs --
PAM_URL=https://pam.staging.igaming.internal
WALLET_URL=https://wallet.staging.igaming.internal
GAL_URL=https://gal.staging.igaming.internal
COMPLIANCE_URL=https://compliance.staging.igaming.internal
RESPONSIBLE_GAMING_URL=https://rg.staging.igaming.internal
GAME_CONTROL_URL=https://gc.staging.igaming.internal
PLATFORM_URL=https://staging.igaming.internal

# -- Database --
DATABASE_HOST=db-staging.igaming.internal
DATABASE_PORT=5432
DATABASE_NAME=igaming_staging
DATABASE_USER=igaming_staging
DATABASE_SSL_MODE=require
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# -- Redis --
REDIS_HOST=redis-staging.igaming.internal
REDIS_PORT=6379
REDIS_DB=0
REDIS_SSL=false

# -- Message queue --
RABBITMQ_HOST=mq-staging.igaming.internal
RABBITMQ_PORT=5672
RABBITMQ_VHOST=igaming-staging
RABBITMQ_USER=igaming

# -- Payment gateways (sandbox mode) --
PAYMENT_MODE=sandbox
STRIPE_API_URL=https://api.stripe.com
STRIPE_MODE=test
ADYEN_API_URL=https://checkout-test.adyen.com
ADYEN_ENVIRONMENT=test
NUVEI_API_URL=https://ppp-test.nuvei.com
PAYSAFE_API_URL=https://api.test.paysafe.com

# -- Feature flags --
FEATURE_NEW_REGISTRATION_FLOW=true
FEATURE_CRYPTO_DEPOSITS=true
FEATURE_LIVE_DEALER=false
FEATURE_SPORTS_BETTING=false
FEATURE_VIP_PROGRAM=true
FEATURE_ENHANCED_KYC=true

# -- Monitoring --
PROMETHEUS_URL=https://prometheus-staging.igaming.internal
GRAFANA_URL=https://grafana-staging.igaming.internal
LOKI_URL=https://loki-staging.igaming.internal
JAEGER_URL=https://jaeger-staging.igaming.internal
SENTRY_DSN=https://staging-key@sentry.igaming.internal/2
LOG_LEVEL=DEBUG
ENABLE_REQUEST_TRACING=true

# -- Compliance --
JURISDICTION=mga
GLI_STANDARD=GLI-11
RNG_VALIDATION_ENABLED=true
RTP_MONITORING_ENABLED=true
RTP_ALERT_THRESHOLD=2.0
AUDIT_LOG_RETENTION_DAYS=90
RESPONSIBLE_GAMING_ENABLED=true
SELF_EXCLUSION_ENABLED=true
DEPOSIT_LIMIT_DEFAULT=1000
SESSION_TIME_LIMIT_MINUTES=480
REALITY_CHECK_INTERVAL_MINUTES=60

# -- Session / Auth --
SESSION_TTL_SECONDS=3600
JWT_EXPIRY_MINUTES=30
REFRESH_TOKEN_EXPIRY_DAYS=7
MAX_CONCURRENT_SESSIONS=3
BRUTE_FORCE_LOCKOUT_ATTEMPTS=5
BRUTE_FORCE_LOCKOUT_MINUTES=15

# -- Rate limiting --
RATE_LIMIT_LOGIN=20/minute
RATE_LIMIT_API=1000/minute
RATE_LIMIT_DEPOSIT=10/minute
RATE_LIMIT_WITHDRAWAL=5/minute

# -- CORS --
CORS_ORIGINS=https://staging.igaming.internal,https://admin-staging.igaming.internal

# -- Encryption --
ENCRYPTION_ALGORITHM=AES-256-GCM
TLS_MIN_VERSION=1.2
