{
    "name": "acmetocasino/change-management",
    "type": "project",
    "description": "Change Management System for iGaming release compliance.",
    "keywords": [
        "change-management",
        "igaming",
        "compliance",
        "laravel"
    ],
    "license": "Apache-2.0",
    "require": {
        "php": "^8.2",
        "ans-group/laravel-health-check": "^3.0",
        "awobaz/compoships": "^3.0",
        "graham-campbell/result-type": "^1.1",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6.3",
        "league/flysystem-aws-s3-v3": "^3.0",
        "maatwebsite/excel": "^3.1.69",
        "mll-lab/graphql-php-scalars": "^6.0",
        "nuwave/lighthouse": "^6.54",
        "orkhanahmadov/laravel-ip-middleware": "^1.10",
        "robsontenorio/laravel-keycloak-guard": "^2.0",
        "scaler-tech/laravel-saml2": "^2.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.9"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
