{
  "_comment": "GitHub branch protection rules for iGaming platform repositories.",
  "_reference": "Chapter 23 — DevSecOps for iGaming / Compliance as Code",
  "_apply_with": "gh api repos/{owner}/{repo}/branches/main/protection -X PUT --input branch-protection.json",

  "required_status_checks": {
    "strict": true,
    "contexts": [
      "Supply Chain — SCA + SBOM",
      "PCI DSS — InSpec Profile",
      "GLI-GSF — OPA Policy Gate",
      "IaC Compliance — Checkov",
      "Container Security — Trivy",
      "Security Pipeline / SAST Scan",
      "Security Pipeline / Secret Detection",
      "ci / build",
      "ci / test"
    ]
  },

  "enforce_admins": true,

  "required_pull_request_reviews": {
    "dismiss_stale_reviews": true,
    "require_code_owner_reviews": true,
    "required_approving_review_count": 2,
    "require_last_push_approval": true,
    "dismissal_restrictions": {
      "users": [],
      "teams": [
        "security-champions",
        "platform-leads"
      ]
    },
    "bypass_pull_request_allowances": {
      "users": [],
      "teams": [
        "break-glass-ops"
      ],
      "apps": [
        "dependabot"
      ]
    }
  },

  "restrictions": {
    "users": [],
    "teams": [
      "platform-leads",
      "security-champions"
    ],
    "apps": [
      "dependabot",
      "renovate"
    ]
  },

  "required_linear_history": true,

  "allow_force_pushes": false,

  "allow_deletions": false,

  "block_creations": false,

  "required_conversation_resolution": true,

  "lock_branch": false,

  "allow_fork_syncing": false
}
