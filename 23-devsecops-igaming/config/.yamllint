# YAMLLint Configuration for DevSecOps Standard
# Extends default configuration with security-focused rules

extends: default

rules:
  # Line length - be reasonable for readability
  line-length:
    max: 120
    level: error

  # Allow empty lines for readability
  empty-lines:
    max: 2
    max-start: 0
    max-end: 1

  # Comments should start with # and a space
  comments:
    min-spaces-from-content: 1

  # Allow longer documents for complex configurations
  document-end:
    present: false

  # Be flexible with indentation (spaces preferred)
  indentation:
    spaces: consistent
    indent-sequences: true
    check-multi-line-strings: false

  # Allow some flexibility in key ordering
  key-ordering: disable

  # Security-focused: require quotes for special characters
  quoted-strings:
    quote-type: any
    required: only-when-needed

  # Allow trailing spaces in some cases
  trailing-spaces: enable

  # Allow empty values when appropriate
  empty-values:
    forbid-in-block-mappings: false
    forbid-in-flow-mappings: false

# Ignore certain files that are autogenerated or have different standards
ignore: |
  .github/workflows/*.yml
  node_modules/
  venv/
  .venv/
  __pycache__/
  *.tfstate*
  .terraform/
